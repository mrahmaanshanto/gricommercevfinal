  "blocks": [
    {
      "id": "blk-signal-delivery",
      "name": "Delivery info",
      "type": "content",
      "content": [
        {
          "type": "h2",
          "text": "Delivery"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Inside Dhaka: 1–2 days, ৳70",
            "Outside Dhaka: 3–5 days, ৳150",
            "Cash on delivery all over Bangladesh"
          ]
        },
        {
          "type": "p",
          "text": "Open the parcel in front of the rider. If something is wrong, give it back right there."
        }
