        {
          "type": "h2",
          "text": "Eid offer: gifts on orders over ৳3,000"
        },
        {
          "type": "cta",
          "label": "See the offers",
          "url": "/offers",
          "style": "solid"
        }
      ]
    },
    {
      "id": "blk-signal-warranty",
      "name": "Warranty info",
      "type": "tab",
      "content": [
        {
          "type": "h2",
          "text": "Warranty"
        },
        {
          "type": "p",
          "text": "Every phone comes with the brand’s official warranty. Accessories have a 6-month shop warranty."
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Keep your invoice or order number",
            "Bring it to Dhanmondi or Mirpur branch",
            "We tell you the cost before any paid repair"
          ]
        }
      ]
    },
    {
      "id": "blk-signal-size",
      "name": "Size guide",
      "type": "tab",
      "content": [
        {
          "type": "h2",
          "text": "Which case fits?"
        },
        {
          "type": "table",
          "header": true,
          "rows": [
            [
              "Phone",
              "Case size"
            ],
            [
              "Galaxy A15 / A25",
              "6.5 in"
            ],
            [
              "Redmi Note 13",
              "6.67 in"
            ],
            [
              "iPhone 15",
              "6.1 in"
            ]
          ]
        }
      ]
    },
    {
      "id": "blk-signal-deals",
      "name": "Phone deals",
      "type": "mega",
      "content": [
        {
          "type": "h2",
          "text": "This week"
        },
        {
          "type": "p",
          "text": "Up to ৳5,000 off selected 5G phones. EMI from 3 months on bank cards."
        },
        {
          "type": "cta",
          "label": "See phone deals",
          "url": "/offers",
          "style": "solid"
        }
      ]
    },
    {
      "id": "blk-signal-footer",
      "name": "Footer",
      "type": "footer",
      "content": [
        {
          "type": "p",
          "text": "**Dazzle Shop** · official phones, accessories and repairs · Dhanmondi and Mirpur"
        },
        {
          "type": "p",
          "text": "Call {{shop_phone}} · hello@dazzleshop.com.bd"
        }
      ]
    }
