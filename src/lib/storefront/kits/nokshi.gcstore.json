            [
              "S",
              "36",
              "40"
            ],
            [
              "M",
              "38",
              "41"
            ],
            [
              "L",
              "40",
              "42"
            ],
            [
              "XL",
              "42",
              "43"
            ]
          ]
        },
        {
          "type": "p",
          "text": "Between two sizes? Take the larger one."
        }
      ]
    },
    {
      "id": "blk-nokshi-warranty",
      "name": "Warranty info",
      "type": "tab",
      "content": [
        {
          "type": "h2",
          "text": "Exchange"
