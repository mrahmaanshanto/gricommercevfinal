    "corners": "round",
    "spacing": "compact",
    "cardRating": false,
    "gallery": "side",
    "showWarranty": false,
    "specsTable": false,
    "reviewsPos": "tab",
    "colsDesktop": "5",
    "filters": "top",
    "sortDefault": "best",
    "perPage": "36",
    "paging": "infinite",
    "freeShipAt": 1000,
    "footerLayout": "simple"
