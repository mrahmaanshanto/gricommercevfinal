          "type": "offer",
          "title": "Free delivery over ৳1,000",
          "text": "Inside Dhaka, every day.",
          "button": "Start shopping",
          "href": "/search?q=",
          "image": "/assets/901f735d539a8b71fb8e8162bb755ec3.webp"
